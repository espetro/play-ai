# AI Provider defaults for development/QA
# These are used ONLY in dev mode to auto-configure the extension on install.
# When all three are set, the extension skips the onboarding setup screen.
#
# VITE_AI_BASE_URL — API endpoint (e.g. https://api.anthropic.com, http://localhost:1234/v1)
# VITE_AI_API_KEY  — API key for the provider (leave empty for local providers like LMStudio)
# VITE_AI_MODEL    — Model identifier (e.g. claude-sonnet-4-20250514, gpt-4o, local-model)

VITE_AI_BASE_URL=
VITE_AI_API_KEY=
VITE_AI_MODEL=

# Browser profile for YouTube testing
# Path to your Chromium-based browser user data directory (used by `bun dev` to avoid YouTube throttling).
# When set, WXT launches the browser with your real profile so YouTube sees a legitimate session.
# Leave empty to use a fresh ephemeral profile (YouTube will likely throttle).
#
# macOS (Helium):  /Users/<you>/Library/Application Support/net.imput.helium
# macOS (Chrome):  /Users/<you>/Library/Application Support/Google/Chrome
# Linux (Chrome):  /home/<you>/.config/google-chrome
CHROME_USER_DATA_DIR=

# Path to the Chromium-based browser executable (used by WXT dev runner and agent-browser).
# Required if Chrome is not installed — points to your alternative browser binary.
#
# macOS (Helium): /Users/<you>/Applications/Helium.app/Contents/MacOS/Helium
# macOS (Chrome): /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
BROWSER_EXECUTABLE_PATH=
