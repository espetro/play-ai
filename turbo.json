{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".output/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true
    },
    "check": {
      "dependsOn": []
    },
    "test": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": []
    },
    "format": {
      "dependsOn": []
    }
  }
}
