{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "react"
  ],
  "categories": {
    "correctness": "error",
    "perf": "error"
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-explicit-any": "error"
  },
  "env": {
    "builtin": true
  }
}