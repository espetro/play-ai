{
  "name": "play-ai",
  "version": "0.1.0",
  "private": true,
  "description": "YouTube AI chat browser extension",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "dev:youtube": "bun run scripts/test-extension.ts --youtube",
    "dev:invidious": "bun run scripts/test-extension.ts --invidious",
    "build": "turbo build",
    "check": "turbo check",
    "lint": "turbo lint",
    "format": "turbo format",
    "test": "turbo test",
    "validate": "bun scripts/validate.ts",
    "changeset": "changeset",
    "version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/bun": "1.3.14",
    "@types/chrome": "0.1.42",
    "@types/node": "24.12.4",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript/native-preview": "7.0.0-dev.20260515.1",
    "oxfmt": "0.50.0",
    "oxlint": "1.64.0",
    "tasuku": "2.3.0",
    "turbo": "2.9.14",
    "vitest": "4.1.6"
  },
  "packageManager": "bun@1.3.14"
}